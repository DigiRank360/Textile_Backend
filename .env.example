# Copy to .env and fill in. On production set these in your host's dashboard.
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=<long-random-string>
# Production frontend + admin URLs (comma separated, no trailing slash)
CLIENT_URLS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# Recommended in production (host disks are often ephemeral)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=Eagle Textile <eaglefabrichub@gmail.com>
ADMIN_EMAIL=eaglefabrichub@gmail.com
